# Backend environment template. Copy to apps/api/.env (gitignored).
# Production domain: documedic.doaide.com (legacy: documedic.aiknol.com)
APP_ENV=development
APP_SECRET_KEY=change-me-openssl-rand-hex-32
APP_DEBUG=true
DEMO_MODE=false

# APP_ENV=production refuses to start on this dev default or a non-PostgreSQL scheme.
DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether_clinician
REDIS_URL=redis://localhost:6379/0

# --- LLM provider ---
# OpenAI (GPT) is the primary provider. Anthropic is a fallback used only when
# LLM_FALLBACK_ENABLED=true and ANTHROPIC_API_KEY is set. Without any key, the
# deterministic text/OCR + offline reasoning path is used (system stays functional).
LLM_PROVIDER=openai
LLM_FALLBACK_ENABLED=true
# Simulated "[DEMO MODE]" reasoning when no provider is reachable. Must be false in production
# (startup refuses otherwise) — a clinician must never be shown fabricated differentials.
LLM_DEMO_FALLBACK=true

# Primary: OpenAI (GPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# Fallback: Anthropic (Claude). Leave blank if you have no Anthropic key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
TESSERACT_CMD=/usr/bin/tesseract

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000
