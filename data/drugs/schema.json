{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aether Clinician drug seed data",
  "definitions": {
    "drug_vocabulary_entry": {
      "type": "object",
      "required": ["generic_name", "reference_id"],
      "properties": {
        "brand_name": {"type": ["string", "null"]},
        "generic_name": {"type": "string"},
        "reference_id": {"type": "string"},
        "atc_code": {"type": ["string", "null"]},
        "drug_class": {"type": ["string", "null"]},
        "strength": {"type": ["string", "null"]},
        "form": {"type": ["string", "null"]}
      }
    },
    "interaction_entry": {
      "type": "object",
      "required": ["drug_a_reference_id", "drug_b_reference_id", "severity", "description", "source"],
      "properties": {
        "drug_a_reference_id": {"type": "string"},
        "drug_b_reference_id": {"type": "string"},
        "severity": {"enum": ["minor", "moderate", "major", "contraindicated"]},
        "evidence_level": {"enum": ["established", "probable", "suspected", "theoretical", null]}
      }
    },
    "contraindication_entry": {
      "type": "object",
      "required": ["drug_reference_id", "condition_name", "severity", "description", "is_absolute", "source"],
      "properties": {
        "drug_reference_id": {"type": "string"},
        "condition_name": {"type": "string"},
        "severity": {"enum": ["relative", "absolute", "dose_adjustment_required"]},
        "is_absolute": {"type": "boolean"},
        "renal_threshold": {
          "description": "eGFR band in mL/min. Applied by app.core.safety._evaluate_renal.",
          "type": ["object", "null"],
          "properties": {
            "egfr_below": {"type": "number"},
            "egfr_above": {"type": "number"},
            "action": {"type": "string"}
          }
        },
        "hepatic_threshold": {
          "description": "Liver-function thresholds, applied by app.core.safety._evaluate_hepatic. A rule naming both markers is breached by EITHER. Only these marker keys are evaluated: a threshold written on any other key can never fire, which is the failure the evaluator was added to end — tests/test_hepatic_dose_adjustment.py holds this file to it.",
          "type": ["object", "null"],
          "properties": {
            "bilirubin_above": {"description": "Total bilirubin, mg/dL", "type": "number"},
            "alt_above": {"description": "ALT/SGPT, U/L", "type": "number"},
            "action": {
              "description": "'contraindicated' is a hard block; anything else is a warning.",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
