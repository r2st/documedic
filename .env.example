# ===== Aether Clinician — root environment template =====
# Copy to .env and fill in. Only *.example files are committed.

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=change-me-openssl-rand-hex-32
APP_DEBUG=true
DEMO_MODE=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether_clinician
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider selection ---
# Fallback chain: OpenAI (primary) -> Anthropic -> OpenRouter -> simulated demo.
LLM_PROVIDER=openai                  # openai | anthropic
LLM_FALLBACK_ENABLED=true            # use the other provider if the primary fails / has no key
LLM_OPENROUTER_FALLBACK=true         # try OpenRouter after openai/anthropic fail / have no key

# --- OpenAI (primary LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# --- Anthropic (fallback LLM) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# --- OpenRouter (fallback LLM, OpenAI-compatible API) ---
# Free models available; prefer a capable one for clinical reasoning. Examples:
# "openrouter/auto", "nvidia/llama-3.3-nemotron-super-49b-v1:free",
# "google/gemma-3-27b-it:free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=4096

# --- Qdrant (Vector Store) — Phase 3 ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=guidelines

# --- File Storage (MinIO for dev) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aether-documents
STORAGE_BACKEND=local                # local | s3
LOCAL_STORAGE_DIR=./storage

# --- OCR ---
TESSERACT_CMD=/usr/bin/tesseract

# --- Auth ---
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_DEMO_MODE=true
