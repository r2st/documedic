# ===== DoAide Med (A DoAide Product) — root environment template =====
# Copy to .env and fill in. Only *.example files are committed.
# Production domain: documedic.doaide.com (legacy: documedic.aiknol.com)

# --- Application ---
APP_ENV=development                  # development | staging | production
APP_SECRET_KEY=change-me-openssl-rand-hex-32
APP_DEBUG=true
DEMO_MODE=false

# --- Database ---
# APP_ENV=production refuses to start on this dev default (its credentials are in the repo)
# and on any non-PostgreSQL scheme.
DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether_clinician
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM provider selection ---
# Fallback chain: OpenAI (primary) -> Anthropic -> OpenRouter -> simulated demo.
LLM_PROVIDER=openai                  # openai | anthropic
LLM_FALLBACK_ENABLED=true            # use the other provider if the primary fails / has no key
LLM_OPENROUTER_FALLBACK=true         # try OpenRouter after openai/anthropic fail / have no key
# Simulated "[DEMO MODE]" clinical reasoning when NO provider can be reached. Handy for demos;
# MUST be false in production — APP_ENV=production refuses to start with it on, because showing
# a clinician fabricated differentials about a real patient is worse than showing nothing.
LLM_DEMO_FALLBACK=true

# --- OpenAI (primary LLM) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# --- Anthropic (fallback LLM) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# --- OpenRouter (fallback LLM, OpenAI-compatible API) ---
# Free models available; prefer a capable one for clinical reasoning. Examples:
# "openrouter/auto", "nvidia/llama-3.3-nemotron-super-49b-v1:free",
# "google/gemma-3-27b-it:free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=4096

# --- Qdrant (Vector Store) — Phase 3 ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=guidelines

# --- File Storage (MinIO for dev) ---
# With STORAGE_BACKEND=s3 in production, both keys below must be changed from "minioadmin".
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=aether-documents
STORAGE_BACKEND=local                # local | s3
LOCAL_STORAGE_DIR=./storage

# --- OCR ---
TESSERACT_CMD=/usr/bin/tesseract

# --- Request size ---
# Hard ceiling on any request body, refused with 413 before the API reads it. Sits just above
# the 20 MB upload limit because a document arrives wrapped in multipart framing; every other
# route is orders of magnitude below it. Do not treat nginx's client_max_body_size as the only
# ceiling — it protects deployments that run nginx in front AND keep the container port
# unreachable, which is a property of a deployment rather than of the application.
MAX_REQUEST_BYTES=25165824

# --- Health probes ---
# GET /health/dependencies calls each configured LLM provider to report whether it actually
# answers. Everything else about the engine is derived from "is a key set", which a revoked or
# out-of-quota key still passes.
LLM_HEALTH_PROBE_TIMEOUT_SECONDS=5.0
LLM_HEALTH_PROBE_TTL_SECONDS=60.0

# --- Reverse proxy ---
# How many proxies YOU operate in front of the API. 0 ignores X-Forwarded-For entirely (it is
# client-settable), which is right for a directly-exposed uvicorn. The reference deployment in
# nginx/nginx.conf is one hop and MUST set 1: left at 0 behind a proxy, every clinician reaches
# the API under the proxy's address, so the login lockout becomes a deployment-wide sign-in
# block, the signup ceiling becomes a global one, and sessions/audit rows record the proxy
# instead of the clinician.
# Nothing can check this at startup — whether a proxy is there is topology, not configuration
# — so the API reports what it sees: GET /health/dependencies carries `proxy_configuration`,
# and `forwarded_for_seen_while_untrusted: true` there means a proxy is setting the header and
# this setting is still 0. Check it once after deploying.
TRUSTED_PROXY_HOPS=0

# --- Auth ---
JWT_ACCESS_TTL_MINUTES=15
# Absolute ceiling on a sign-in, not on a token: rotation carries the family's start forward,
# so a client that keeps refreshing still has to re-enter a password after this long.
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12
# Failed-login budgets, counted from the append-only audit log over
# LOGIN_ATTEMPT_WINDOW_MINUTES. The two are separate on purpose: the per-account budget
# protects one password, the per-address one catches guessing spread across many accounts and
# is far looser because a shared egress address (a clinic NAT, or a proxy when
# TRUSTED_PROXY_HOPS is wrong) accumulates everyone's honest typos. Either can be set to 0 to
# disable that arm alone.
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=60
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15
# Ceiling on how many sign-ins one account may hold at once; 0 disables it. Enforced by
# evicting the least recently used session on a new sign-in, never by refusing the sign-in —
# refusing would let anyone who learns a password lock the clinician out by filling the cap,
# and would fail in the direction that keeps someone out of a chart mid-consultation. Raise it
# for a deployment where one clinician legitimately works from many terminals at once.
SESSION_MAX_CONCURRENT=10

# --- Rate limiting (per account, on the routes that cost an LLM call) ---
# Enforced in-process, so these are per-worker ceilings; the Dockerfile runs one worker. Set
# any single value to 0 to disable that bucket, or RATE_LIMIT_ENABLED=false for all of them —
# appropriate if your front end already terminates rate limiting.
# Deliberately NOT metered: the deterministic drug-safety routes and chart reads. A 429 on an
# allergy cross-check reads to a hurried clinician as "no conflict found".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REASONING_RUNS_PER_MINUTE=10   # full eight-agent panel; ../run and ../stream share it
RATE_LIMIT_INTAKE_PER_MINUTE=30           # session open + intake answers (one Triage call each)
RATE_LIMIT_UPLOADS_PER_MINUTE=20          # multimodal extraction over a scan
RATE_LIMIT_SEARCHES_PER_MINUTE=60         # guideline embedding + vector search
RATE_LIMIT_SIGNUPS_PER_HOUR=10            # per client address; stops the ceilings above being
                                          # bypassed by signing up repeatedly

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_DEMO_MODE=false
